{
  "name": "dsh-plugin-desktop-control",
  "version": "1.0.0",
  "description": "Desktop control for DeepSeek Harness: see the screen with built-in OCR, click, type, manage windows and drive Windows applications such as WeChat.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "agent",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "desktop",
    "automation",
    "screen",
    "ocr",
    "wechat",
    "ui-automation"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.2-rc.5 <0.4.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
